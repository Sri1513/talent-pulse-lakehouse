# ── Source: de-job-intelligence OLTP (Oracle VM Postgres, over Tailscale) ──
DB_HOST=100.118.69.90
DB_PORT=5432
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_NAME=job_scout_db
DB_SCHEMA=scout

# ── Lakehouse storage: MinIO (S3-compatible, on de-lab) ──
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
LAKEHOUSE_BUCKET=talent-pulse-lake

# ── Spark ──
SPARK_MASTER=local[*]
SPARK_APP_NAME=talent-pulse-lakehouse

# ── Domain (plug-and-play: one config file per domain) ──
DEFAULT_DOMAIN=data-engineering

# ── Gold serving: marts synced back to Postgres for the dashboard ──
MARTS_SCHEMA=analytics

# ── Trigger webhook (ingestion-finish receiver) ──
WEBHOOK_PORT=8080
WEBHOOK_SECRET=CHANGE_ME

# ── Logging ──
LOG_LEVEL=INFO